// University Room Booking System — v1.0 data model
// v2.0 note: BookingStatus gains PENDING and REJECTED for the admin
// approval workflow (rooms with capacity > 100). See confluence/adr-001.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

// Room features users can filter by (BOOK-22).
enum Equipment {
  PROJECTOR
  COMPUTERS
  WHITEBOARD
}

enum BookingStatus {
  ACTIVE
  CANCELLED
}

model User {
  id       String    @id
  name     String
  role     Role
  bookings Booking[]
}

model Room {
  id        String      @id
  name      String
  capacity  Int
  equipment Equipment[] @default([])
  bookings  Booking[]
}

model Booking {
  id        String        @id @default(cuid())
  roomId    String
  userId    String
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(ACTIVE)
  createdAt DateTime      @default(now())

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([roomId, startTime, endTime])
  @@index([userId])
}
